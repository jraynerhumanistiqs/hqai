.env.local
.env*.local
node_modules/
.next/
out/
*.log
.DS_Store

# Build artifacts. Glob, not a single name - every tsconfig.*.json emits its
# own, e.g. tsconfig.e2e.tsbuildinfo from `npm run typecheck:e2e`.
*.tsbuildinfo

# Eval judge cache (per-run, regenerated automatically)
tests/eval/.cache/

# Eval run output. tests/eval/run-eval.ts defaults --out to the repo root, so
# these land here on every run and were getting committed. eval.json is NOT
# ignored - that one is the suite INPUT that scripts/eval-selfserve.mjs reads.
eval-report.json
eval-report.md

# Claude Flow internal scratch
.claude-flow/agents/
scripts/*.env
scripts/stripe-v2-price-ids.env
scripts/stripe-v2-price-ids.live.env

.vercel

# KB answering pipeline: PROMPT.md is regenerated by `answers_tool.py pack`
# from the research report, so it is build output. ANSWERS.md is NOT ignored -
# once an agent fills one it is the work product and must be versioned.
docs/research/au-hr-recruitment-2026/supabase/batches/*/PROMPT.md
__pycache__/
*.pyc

# Dev-only Supabase credentials for the PPAD fixture. Service role key -
# never commit. See scripts/ppad/dev-seed.mjs.
.env.ppad-dev
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Playwright run output (traces may embed request/response data)
test-results/
